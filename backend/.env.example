# Application
DEBUG=true
SECRET_KEY=replace-with-a-long-random-value
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# PostgreSQL (SQLite is unsupported)
DATABASE_URL=postgresql://dailyfuel:change-this-password@127.0.0.1:5432/dailyfuel
# Set true for transaction poolers, including Neon pooled connections.
DATABASE_DISABLE_SERVER_SIDE_CURSORS=false

# Private progress media
PRIVATE_MEDIA_ROOT=/absolute/path/to/DailyFuel/backend/private-media
PHOTO_MAX_BYTES=10485760

# Google OAuth web credentials. Callback:
# http://localhost:8000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Development uses console email automatically. For production, set all SMTP values.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=DailyFuel <noreply@example.com>

# Render + Vercel production: DEBUG=false, FRONTEND_URL=https://your-project.vercel.app.
# TRUST_PROXY_HEADERS=true only behind a trusted TLS-terminating proxy such as Render.
TRUST_PROXY_HEADERS=false
# Render's filesystem is ephemeral; use a PRIVATE Supabase S3-compatible bucket.
PRIVATE_MEDIA_BACKEND=local
S3_ENDPOINT_URL=
S3_REGION_NAME=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Render Free blocks SMTP ports 25/465/587. Use HTTPS email instead.
# EMAIL_BACKEND=accounts.email_backend.BrevoEmailBackend
BREVO_API_KEY=
EMAIL_TIMEOUT=15

# Enable only after configuring Brevo and the scheduled worker.
WEEKLY_EMAIL_ENABLED=false
# Reserve room within Brevo's shared daily allowance for other app emails.
WEEKLY_EMAIL_DAILY_LIMIT=200
